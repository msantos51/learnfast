{
  "name": "mapa-de-compassos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aprender músicas a partir de ficheiros Guitar Pro: esquema por secções e compassos, com cores por nota e leitor para praticar.",
  "scripts": {
    "vendor": "node scripts/copy-alphatab.mjs",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
